{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.spacefast/mcp",
  "title": "Spacefast",
  "description": "Build, publish, and manage websites, dashboards, reports, and web tools with Spacefast.",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/spacefast/plugins/main/assets/logo-400.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ],
  "version": "0.9.0",
  "repository": {
    "url": "https://github.com/spacefast/mcp",
    "source": "github"
  },
  "websiteUrl": "https://spacefast.com",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "spacefast",
      "version": "0.9.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.spacefast.com"
    }
  ]
}
